# Runtime data — never commit. Holds the browser profile, the DPAPI-encrypted
# session cookie, and the scraped database.
data/
output/

# The Chromium profile contains a live LSM session. Treat it like a password.
profile/
profile-edge/

# Listed by name too, not just via data/: a dev checkout pointed at LSM_DATA_DIR
# outside data/ would otherwise make the cookie snapshot and the DB committable.
session.bin
*.db

.venv/
venv/
__pycache__/
*.py[cod]

# PyInstaller
# build/ is its scratch directory; the .spec in packaging/ is source.
build/
dist/

# Logs
*.log

.env
.env.*
!.env.example
